// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme",
  },
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "experimental.theme_overrides": {
    "syntax": {
      "comment": {
        "font_style": "italic",
      },
    },
  },

  // ROOT CONFIG FOR ZED: DO NOT CHANGE ANYTHING HERE FROM BELOW
  "disable_ai": true,
  "calls": {
    "mute_on_join": true,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
      "show_commit_summary": false,
    },
  },
  "terminal": {
    "shell": "system",
  },
  "agent": {
    "button": false,
    "dock": "left",
    "model_parameters": [],
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "notification_panel": {
    "button": true,
  },
  "debugger": {
    "dock": "right",
  },
  "git_panel": {
    "tree_view": true,
    "dock": "right",
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "auto_reveal_entries": true,
    "auto_open": {
      "on_create": false,
      "on_drop": false,
      "on_paste": false,
    },
    "sticky_scroll": true,
    "hide_gitignore": false,
    "dock": "right",
  },
  "bottom_dock_layout": "contained",
  "tab_bar": {
    "show_tab_bar_buttons": true,
    "show": true,
  },
  "title_bar": {
    "show_menus": true,
    "show_branch_icon": true,
  },
  "tabs": {
    "show_close_button": "always",
    "show_diagnostics": "all",
    "file_icons": true,
  },
  "tab_size": 2,
  "show_wrap_guides": true,
  "current_line_highlight": "all",
  "cursor_shape": "block",
  "redact_private_values": true,
  "when_closing_with_no_tabs": "keep_window_open",
  "sticky_scroll": {
    "enabled": false,
  },
  "vertical_scroll_margin": 5.0,
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}
